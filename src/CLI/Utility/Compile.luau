---- Private Functions ----

local function Message(Color: stdio.Color, Options: CompileOptions, ...)
	if Options.Silent then
		return
	end

	stdio.write(stdio.color(Color))
	print(...)
	stdio.write(stdio.color("reset"))
end

local function FormatTime(Time: number): string
	if Time < 1E-6 then
		return `{Time * 1E+9} ns`
	elseif Time < 0.001 then
		return `{Time * 1E+6} μs`
	elseif Time < 1 then
		return `{Time * 1000} ms`
	else
		return `{Time} seconds`
	end
end

local function CreateDirectoryIfNotFound(Path: string, Options: CompileOptions)
	local Directory = PathParser.Directory(Path) or "./"
	if fs.isDir(Directory) then
		return
	end

	local Result = Options.YesToEverything
		or stdio.prompt("confirm", `Directory {Directory} doesn't exist, create directory?`)

	if Result then
		fs.writeDir(Directory)
		return
	end

	error("User refused prompt to create directory")
end

type ModulePaths = {
	Directory: string,
	Init: string,
	Types: string,
	Typescript: string,
	Stale: { string },
}

local function ResolvePath(Path: string, FileDirectory: string): string
	return if PathParser.PathType(Path) == "absolute" then Path else `{FileDirectory}{Path}`
end

--> Client and server are always emitted as folder modules so their types child travels with them
local function GetModulePaths(OutputPath: string, FileDirectory: string): ModulePaths
	local Directory, Filename = PathParser.Components(ResolvePath(OutputPath, FileDirectory))
	assert(Directory and Filename, `Unable to parse filename from {OutputPath}, path may be malformed!`)

	local Stale = {}
	if Filename ~= "init" then
		Stale = { `{Directory}{Filename}.luau`, `{Directory}{Filename}.d.ts` }
		Directory = `{Directory}{Filename}/`
	end

	return {
		Directory = Directory,
		Init = `{Directory}init.luau`,
		Types = `{Directory}{Generator.TypesChild}.luau`,
		Typescript = `{Directory}index.d.ts`,
		Stale = Stale,
	}
end

--> Files left at the output path would collide with the folder module of the same name
local function RemoveStaleModule(Paths: ModulePaths, Options: CompileOptions)
	for _, Stale in Paths.Stale do
		if not fs.isFile(Stale) then
			continue
		end

		local Result = Options.YesToEverything
			or stdio.prompt("confirm", `{Stale} is replaced by the folder module {Paths.Directory}, remove it?`)

		if not Result then
			error(`User refused to remove {Stale}, it would collide with the folder module {Paths.Directory}`)
		end

		fs.removeFile(Stale)
	end
end

--> Roblox stops natively compiling a module after roughly this much source, measured in Studio
local NATIVE_BUDGET_BYTES = 1_200_000
local GENERATED_HEADER = "-- File generated by Blink"

local function WriteModule(Paths: ModulePaths, Files: { [string]: string }, TypesSource: string, Options: CompileOptions)
	fs.writeFile(Paths.Init, Files.init)
	fs.writeFile(Paths.Types, TypesSource)

	for Name, Source in Files do
		if Name ~= "init" then
			fs.writeFile(`{Paths.Directory}{Name}.luau`, Source)
		end

		if #Source > NATIVE_BUDGET_BYTES then
			Message(
				"yellow",
				Options,
				`{Paths.Directory}{Name}.luau is {#Source} bytes, Roblox only natively compiles about the first {NATIVE_BUDGET_BYTES} bytes of a module. Split its .blink file into imports.`
			)
		end
	end

	--> Modules of .blink files that no longer exist, only files Blink generated are touched
	for _, Entry in fs.readDir(Paths.Directory) do
		local Name = string.match(Entry, "^(.+)%.luau$")
		local EntryPath = `{Paths.Directory}{Entry}`
		if not Name or Name == "init" or Name == Generator.TypesChild or Files[Name] ~= nil or not fs.isFile(EntryPath) then
			continue
		end

		if string.find(fs.readFile(EntryPath), GENERATED_HEADER, 1, true) then
			fs.removeFile(EntryPath)
		end
	end
end

---- Public Functions ----

function Utility.Compile(Path: string, Options: CompileOptions)
	local FilePath = GetDefinitionFilePath(Path)
	Error.SetCompact(Options.Compact)

	Message("cyan", Options, `Reading source from {FilePath}...`)
	local Source = fs.readFile(FilePath)

	Message("blue", Options, "Parsing source into AST...")
	local FileDirectory = PathParser.Directory(FilePath) or "./"
	local SourceParser = Parser.new(FileDirectory, PathParser.NameWithExtension(FilePath))

	local ParseStart = os.clock()
	local AbstractSyntaxTree = SourceParser:Parse(Source)
	local ParseTime = (os.clock() - ParseStart)

	if Options.OutputAbstractSyntaxTree then
		print(AbstractSyntaxTree.Value.Options)
		print(AbstractSyntaxTree.Value.Declarations)
		return
	end

	local FileOptions = AbstractSyntaxTree.Value.Options
	assert(FileOptions.ClientOutput, "A client output path must be defined.")
	assert(FileOptions.ServerOutput, "A server output path must be defined.")

	local ClientPaths = GetModulePaths(FileOptions.ClientOutput, FileDirectory)
	local ServerPaths = GetModulePaths(FileOptions.ServerOutput, FileDirectory)
	local TypesOutput = if FileOptions.TypesOutput then ResolvePath(FileOptions.TypesOutput, FileDirectory) else nil

	RemoveStaleModule(ClientPaths, Options)
	RemoveStaleModule(ServerPaths, Options)
	CreateDirectoryIfNotFound(ClientPaths.Init, Options)
	CreateDirectoryIfNotFound(ServerPaths.Init, Options)

	Message("blue", Options, "Generating output files...")
	local FilesStart = os.clock()

	local RootName = PathParser.Filename(FilePath)
	assert(RootName, `Unable to parse filename from {FilePath}, path may be malformed!`)

	local ServerGenerateStart = os.clock()
	local ServerFiles = Generator.Generate("Server", AbstractSyntaxTree, RootName)
	local ServerGenerateTime = (os.clock() - ServerGenerateStart)

	local ClientGenerateStart = os.clock()
	local ClientFiles = Generator.Generate("Client", AbstractSyntaxTree, RootName)
	local ClientGenerateTime = (os.clock() - ClientGenerateStart)

	local TypesSource = Generator.GenerateShared(AbstractSyntaxTree)

	local ClientTypescriptSource: string?
	local ServerTypescriptSource: string?
	if FileOptions.Typescript then
		ClientTypescriptSource = Generator.GenerateTypescript("Client", AbstractSyntaxTree)
		ServerTypescriptSource = Generator.GenerateTypescript("Server", AbstractSyntaxTree)
	end

	local FilesTime = (os.clock() - FilesStart)
	WriteModule(ServerPaths, ServerFiles, TypesSource, Options)
	WriteModule(ClientPaths, ClientFiles, TypesSource, Options)

	if TypesOutput then
		CreateDirectoryIfNotFound(TypesOutput, Options)
		fs.writeFile(TypesOutput, TypesSource)
	end

	if ClientTypescriptSource and ServerTypescriptSource then
		fs.writeFile(ClientPaths.Typescript, ClientTypescriptSource)
		fs.writeFile(ServerPaths.Typescript, ServerTypescriptSource)
	end

	Message("green", Options, "Network files generated!")

	if Options.Debug and not Options.Silent then
		print(`[DEBUG]: Parsed source in {FormatTime(ParseTime)}.`)
		print(`[DEBUG]: Generated server luau in {FormatTime(ServerGenerateTime)}.`)
		print(`[DEBUG]: Generated client luau in {FormatTime(ClientGenerateTime)}.`)
		print(`[DEBUG]: Generated files in {FormatTime(FilesTime)}.`)
		print(`[DEBUG]: Completed everything in {FormatTime(ParseTime + FilesTime)}.`)
	end
end

